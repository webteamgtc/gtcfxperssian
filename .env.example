# Strapi CMS (server side only — copy to .env.local and fill in)
STRAPI_URL=https://api.gtcfx.com
STRAPI_TOKEN=
STRAPI_REVALIDATE=300
# optional collection overrides for the Events & Exhibitions page
# STRAPI_FUTURE_EVENTS_COLLECTION=future-events
# STRAPI_EVENTS_COLLECTION=comments

# Mailgun (VPS application e-mails — src/config/nodemailer.js)
MAILGUN_API_KEY=
MAILGUN_USERNAME=api
MAILGUN_API_URL=https://api.mailgun.net

# VPS application form → Zapier catch hook (src/app/api/vps-data-email/route.js)
VPS_ZAPIER_HOOK_URL=

# Platform guides — Google Drive service account (src/lib/platform-guide/googleDrive.js)
# Production: GOOGLE_SERVICE_ACCOUNT_JSON (single-line JSON or base64) or GOOGLE_DRIVE_CLIENT_EMAIL + GOOGLE_DRIVE_PRIVATE_KEY.
# Local dev: key file at SECRETS_DIR/GOOGLE_SERVICE_ACCOUNT_FILE (secrets/ is gitignored).
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_CLIENT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=
SECRETS_DIR=secrets
GOOGLE_SERVICE_ACCOUNT_FILE=google-drive-service-account.json
GOOGLE_DRIVE_GTCGO_FOLDER_ID=
GOOGLE_DRIVE_GTCFX_PORTAL_FOLDER_ID=
# PLATFORM_GUIDE_CACHE_SECONDS=600

# Platform guides — YouTube tutorial playlists (src/lib/platform-guide/youtube.js)
# Optional: without a key the public playlist pages are read instead.
YOUTUBE_API_KEY=
# YOUTUBE_PLAYLIST_ID_EN=

# Translations for languages other than en / ar / zh (<base>/<lang>.json). Optional — defaults to the GTCFX bucket.
# MESSAGES_S3_BASE=https://gtcfx-bucket.s3.ap-southeast-1.amazonaws.com/translation
